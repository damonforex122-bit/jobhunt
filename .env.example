# Copy this file to .env. Empty values count as unset. The setup wizard writes keys here for you.

# AI keys (one is enough). Gemini has a free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Finding people (optional)
APOLLO_API_KEY=
EXA_API_KEY=

# Gmail, read-only. App password: https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Google OAuth alternative (Advanced)
GMAIL_CLIENT_SECRET=
GMAIL_TOKEN=

# Files and folders
MASTER_RESUME_PATH=
RESUME_OUTPUT_DIR=
DB_PATH=
WATCHLIST_PATH=
PROFICIENTLY_DIR=
ENV_PATH=
